---
/**
 * Button — link-styled call to action in four shapes. With `href` it renders an <a>; with `href={null}`
 * (e.g. WhatsApp number still pending) it renders a non-focusable <span> with the same shape plus a small badge.
 *
 * Props: href (string | null), variant ("pennant" | "primary" | "outline" | "maiz" | "link", default "primary"),
 *        size ("md" | "lg"), external? (new tab, rel noopener), badge? (text shown when href is null),
 *        srSuffix? (visually hidden text appended to the accessible name, e.g. "Abre WhatsApp"), class.
 * Slots: default (label).
 * Usage: <Button href={url} variant="outline" external srSuffix={site.ui.abreMaps}>{label}</Button>
 * Depends on: src/lib/cn.ts, tailwind-variants
 */
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string | null;
  variant?: "pennant" | "primary" | "outline" | "maiz" | "link" | undefined;
  size?: "md" | "lg" | undefined;
  external?: boolean;
  badge?: string | undefined;
  srSuffix?: string | undefined;
}

const button = tv({
  base: "relative isolate inline-flex min-h-12 min-w-12 flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center font-sans font-bold uppercase leading-tight tracking-wide",
  variants: {
    variant: {
      pennant:
        "py-2 pl-6 pr-10 text-papel before:absolute before:inset-0 before:-z-10 before:bg-nopal before:clip-pennant before:transition-colors before:content-['']",
      primary: "rounded-brand border-[3px] border-tinta bg-primary px-5 py-2 text-primary-foreground shadow-sello transition-colors",
      outline: "rounded-brand border-[3px] border-tinta bg-transparent px-5 py-2 text-tinta transition-colors",
      maiz: "rounded-brand border-[3px] border-tinta bg-maiz px-5 py-2 text-tinta shadow-sello transition-colors",
      link: "px-1 py-2 text-tinta underline decoration-2 underline-offset-4",
    },
    size: { md: "text-sm sm:text-base", lg: "text-base sm:text-lg" },
    interactive: { true: "", false: "" },
  },
  compoundVariants: [
    { variant: "pennant", interactive: true, class: "hover:before:bg-nopal-oscuro active:before:bg-nopal-oscuro" },
    { variant: "primary", interactive: true, class: "hover:bg-adobo-oscuro active:translate-x-px active:translate-y-px" },
    { variant: "outline", interactive: true, class: "hover:bg-papel-claro" },
    { variant: "maiz", interactive: true, class: "hover:bg-papel-claro active:translate-x-px active:translate-y-px" },
    { variant: "link", interactive: true, class: "hover:text-adobo-oscuro" },
  ],
  defaultVariants: { variant: "primary", size: "md", interactive: true },
});

const { href, variant, size, external = false, badge, srSuffix, class: className, ...rest } = Astro.props;
const classes = button({ variant, size, interactive: href !== null, class: className });
---

{
  href !== null ? (
    <a
      href={href}
      class={classes}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener" : undefined}
      {...rest}
    >
      <slot />
      {srSuffix && <span class="sr-only"> ({srSuffix})</span>}
    </a>
  ) : (
    <span class={classes} {...(rest as HTMLAttributes<"span">)}>
      <slot />
      {badge && (
        <span class="whitespace-nowrap rounded-sm border border-tinta bg-papel-claro px-1.5 py-0.5 text-xs font-semibold normal-case leading-none tracking-normal text-tinta">
          {badge}
        </span>
      )}
    </span>
  )
}
