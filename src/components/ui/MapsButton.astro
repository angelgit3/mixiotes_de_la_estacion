---
/**
 * MapsButton — "Cómo llegar" link to Google Maps (confirmed share URL, else an address search).
 *
 * Props: variant/size/class (forwarded to Button).
 * Slots: default (label).
 * Usage: <MapsButton variant="outline">{site.heroe.ctaSecundario}</MapsButton>
 * Depends on: Button, src/data/site.ts, src/lib/links.ts
 */
import { site } from "../../data/site";
import { mapsHref } from "../../lib/links";
import { isPending } from "../../data/schema";
import Button from "./Button.astro";

interface Props {
  variant?: "pennant" | "primary" | "outline" | "maiz" | "link" | undefined;
  size?: "md" | "lg" | undefined;
  class?: string | undefined;
}

// Borrador only (production forbids pending): the search link works but is built from an unconfirmed address.
const addressPending =
  isPending(site.ubicacion.mapsUrl) && (isPending(site.ubicacion.calle) || isPending(site.ubicacion.colonia));
const { variant, size, class: className } = Astro.props;
---

<Button href={mapsHref(site)} external variant={variant} size={size} class={className} flag={addressPending ? site.ui.direccionPendiente : undefined} srSuffix={site.ui.abreMaps}>
  <slot />
</Button>
