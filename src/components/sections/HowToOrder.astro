---
/**
 * HowToOrder — "Aparta en 3 pasos": numbered steps, counter photo and the WhatsApp CTA.
 *
 * Props: none.
 * Slots: none.
 * Usage: <HowToOrder />
 * Depends on: Section, SectionHeading, Photo, WhatsAppButton, src/data/site.ts
 */
import { site } from "../../data/site";
import Photo from "../ui/Photo.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";

const data = site.comoApartar;
---

<Section id="como-apartar" tone="oscuro">
  <SectionHeading id="como-apartar" title={data.titulo} intro={data.intro} />
  <div class="mt-12 grid items-start gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <ol class="space-y-8">
        {
          data.pasos.map((paso, i) => (
            <li class="flex gap-5">
              <span
                aria-hidden="true"
                class="flex size-16 shrink-0 items-center justify-center rounded-full border-[3px] border-tinta bg-maiz font-display text-4xl leading-none text-tinta shadow-sello"
              >
                {i + 1}
              </span>
              <div class="pt-1">
                <h3 class="font-display text-2xl uppercase tracking-wide text-tinta sm:text-3xl">{paso.titulo}</h3>
                <p class="mt-1 max-w-lg text-lg text-pretty">{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-10">
        <WhatsAppButton message="apartar" variant="pennant" size="lg" class="min-h-14">{data.cta}</WhatsAppButton>
      </div>
    </div>
    <div class="lg:col-span-5">
      <Photo name={data.imagen} sizes="(min-width: 1152px) 470px, (min-width: 1024px) 40vw, calc(100vw - 32px)" />
    </div>
  </div>
</Section>
