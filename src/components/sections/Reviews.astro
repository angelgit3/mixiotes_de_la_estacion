---
/**
 * Reviews — "Lo que dicen": review cards (author, star rating as accessible text, text, date, source).
 * Never invents content: with an empty list (draft preview only) it shows an empty-state card with the
 * Pending chip. Disabled by default in sitio.json.
 *
 * Props: none.
 * Slots: none.
 * Usage: <Reviews />
 * Depends on: Section, SectionHeading, Pending, src/data/site.ts
 */
import { site } from "../../data/site";
import Pending from "../ui/Pending.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const data = site.resenas;
const dateFormat = new Intl.DateTimeFormat("es-MX", { month: "long", year: "numeric", timeZone: "UTC" });
const star = "M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8Z";
---

<Section id="resenas" tone="oscuro">
  <SectionHeading id="resenas" title={data.titulo} intro={data.intro} />
  {
    data.lista.length > 0 ? (
      <ul class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {data.lista.map((r) => (
          <li class="flex flex-col rounded-brand border-[3px] border-tinta bg-papel-claro p-6 shadow-sello">
            <p class="flex items-center gap-0.5">
              {[1, 2, 3, 4, 5].map((n) => (
                <svg viewBox="0 0 24 24" aria-hidden="true" class={`size-6 stroke-adobo stroke-2 ${n <= r.estrellas ? "fill-adobo" : "fill-none"}`}>
                  <path d={star} stroke-linejoin="round" />
                </svg>
              ))}
              <span class="sr-only">{site.ui.estrellas.replace("{n}", String(r.estrellas))}</span>
            </p>
            <blockquote class="mt-4 flex-1 text-lg text-pretty">{r.texto}</blockquote>
            <footer class="mt-5 border-t-2 border-dotted border-tinta-suave pt-4 text-base">
              <p class="font-bold">{r.autor}</p>
              <p class="text-tinta-suave">
                <time datetime={r.fecha}>{dateFormat.format(new Date(`${r.fecha}T00:00:00Z`))}</time> ·{" "}
                {r.url ? (
                  <a href={r.url} target="_blank" rel="noopener" class="font-semibold underline underline-offset-4">
                    {r.fuente}
                  </a>
                ) : (
                  r.fuente
                )}
              </p>
            </footer>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-12 max-w-xl rounded-brand border-[3px] border-dashed border-tinta-suave bg-papel-claro/70 p-6 text-lg">
        {site.ui.textoPendiente}
        <Pending note={data.intro} />
      </p>
    )
  }
</Section>
