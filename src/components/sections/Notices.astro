---
/**
 * Notices — "Avisos y horarios especiales": active announcements styled as pinned notes
 * (date, type badge, title, detail), or a calm empty note.
 *
 * Props: none.
 * Slots: none.
 * Usage: <Notices />
 * Depends on: Section, SectionHeading, src/data/site.ts, src/lib/notices.ts
 */
import { site } from "../../data/site";
import { activeNotices } from "../../lib/notices";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const data = site.avisos;
// Today in Mexico City, as YYYY-MM-DD (en-CA formats dates that way).
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Mexico_City" }).format(new Date());
const list = activeNotices(data.lista, today);
const dateFormat = new Intl.DateTimeFormat("es-MX", { dateStyle: "long", timeZone: "UTC" });
const badge = {
  cerrado: "bg-adobo text-papel",
  horario: "bg-maiz text-tinta",
  general: "bg-nopal text-papel",
} as const;
---

<Section id="avisos">
  <SectionHeading id="avisos" title={data.titulo} intro={data.intro} />
  {
    list.length > 0 ? (
      <ul class="mt-12 grid gap-8 md:grid-cols-2">
        {list.map((n) => (
          <li class="relative rounded-brand border-[3px] border-tinta bg-papel-claro p-6 pt-8 shadow-sello">
            <span aria-hidden="true" class="absolute -top-3 left-6 size-6 rounded-full border-[3px] border-tinta bg-adobo" />
            <div class="flex flex-wrap items-center gap-3">
              <span class={`rounded-sm px-2 py-1 text-xs font-bold uppercase tracking-widest ${badge[n.tipo]}`}>
                {site.ui.tiposAviso[n.tipo]}
              </span>
              <time datetime={n.fecha} class="text-base font-semibold text-tinta-suave">
                {dateFormat.format(new Date(`${n.fecha}T00:00:00Z`))}
              </time>
            </div>
            <h3 class="mt-3 font-display text-2xl uppercase tracking-wide text-primary sm:text-3xl">{n.titulo}</h3>
            {n.detalle && <p class="mt-2 text-lg text-pretty">{n.detalle}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-12 max-w-xl rounded-brand border-[3px] border-dashed border-tinta-suave bg-papel-claro/70 p-6 text-lg">
        {data.vacio}
      </p>
    )
  }
</Section>
